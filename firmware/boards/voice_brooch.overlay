/*
 * Voice Brooch custom PCB — nRF52840
 *
 * Pin map (brooch PCB v1):
 *   P0.11  Main button (active low, pull-up)
 *   P0.13  Status LED (active high)
 *   P0.12  Charging detect (high = charging)
 *   P0.03  MEMS mic analog (SAADC AIN1)
 *   P0.04  Battery sense (SAADC AIN2, via divider)
 *
 * Usage:
 *   west build -b nrf52840dk_nrf52840 -- -DOVERLAY_CONFIG=boards/voice_brooch.overlay
 *   pio run -e nrf52840_brooch
 */

/ {
    model = "VoiceBrooch PCB v1";
    compatible = "voicebrooch,pcb-v1";

    chosen {
        zephyr,console = &uart0;
        zephyr,shell-uart = &uart0;
    };

    aliases {
        sw0 = &brooch_button;
        led0 = &brooch_led;
        charge0 = &charge_input;
    };

    buttons {
        compatible = "gpio-keys";
        brooch_button: brooch_button {
            gpios = <&gpio0 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
            label = "Brooch main button";
            zephyr,code = <INPUT_KEY_0>;
        };
    };

    leds {
        compatible = "gpio-leds";
        brooch_led: brooch_led {
            gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>;
            label = "Brooch status LED";
        };
    };

    brooch_charge: brooch_charge {
        compatible = "gpio-keys";
        charge_input: charge_input {
            gpios = <&gpio0 12 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
            label = "Charging detect";
        };
    };

    /* ADC channel indices for board_nrf52.c */
    zephyr,user {
        io-channels = <&adc 1>, <&adc 2>;
    };
};

&adc {
    status = "okay";
    #address-cells = <1>;
    #size-cells = <0>;

    channel@1 {
        reg = <1>;
        zephyr,gain = "ADC_GAIN_1_6";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,input-positive = <NRF_SAADC_AIN1>;
        zephyr,resolution = <12>;
        label = "MIC_ADC";
    };

    channel@2 {
        reg = <2>;
        zephyr,gain = "ADC_GAIN_1_6";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,input-positive = <NRF_SAADC_AIN2>;
        zephyr,resolution = <12>;
        label = "BATT_ADC";
    };
};

/* Lower TX power for wearable */
&radio {
    tx-power-level = "0";
};
